<mxfile host="app.diagrams.net"><diagram id="current" name="Current implementation — demo as built"><mxGraphModel dx="1920" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
    <mxCell id="title" value='&lt;b style="font-size:34px"&gt;Current implementation — demo as built&lt;/b&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="48.0" y="30.0" width="1100.0" height="50.0" as="geometry"/></mxCell>
    <mxCell id="subtitle" value="C4 system context and container view · what this repository implements and runs today" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontColor=#555555;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="48.0" y="84.0" width="1100.0" height="28.0" as="geometry"/></mxCell>
    <mxCell id="badge" value="IMPLEMENTED · runs today" style="rounded=1;arcSize=50;html=1;fillColor=#166534;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1644.8" y="40.0" width="227.2" height="38.0" as="geometry"/></mxCell>
    <mxCell id="zone-system" value='&lt;b&gt;Voice Line demo&lt;/b&gt; &lt;font color="#666666"&gt;[software system]&lt;/font&gt;' style="rounded=1;arcSize=2;html=1;fillColor=none;strokeColor=#333333;strokeWidth=2.5;dashed=1;dashPattern=10 6;fontColor=#111111;fontSize=16.8;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="355.0" y="165.0" width="1060.0" height="625.0" as="geometry"/></mxCell>
    <mxCell id="zone-iphone" value="&lt;b&gt;iPhone&lt;/b&gt;" style="rounded=1;arcSize=2;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=2;dashed=1;dashPattern=7 5;fontColor=#475569;fontSize=16.8;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="385.0" y="225.0" width="300.0" height="535.0" as="geometry"/></mxCell>
    <mxCell id="zone-laptop" value='&lt;b&gt;Developer laptop&lt;/b&gt; &lt;font color="#666666"&gt;(same Wi-Fi network)&lt;/font&gt;' style="rounded=1;arcSize=2;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=2;dashed=1;dashPattern=7 5;fontColor=#475569;fontSize=16.8;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="925.0" y="225.0" width="455.0" height="535.0" as="geometry"/></mxCell>
    <mxCell id="node-rep" value='&lt;i style="font-size:15.1px;color:#DCE9F7"&gt;[Person]&lt;/i&gt;&lt;br&gt;&lt;b style="font-size:20.2px"&gt;Sales rep&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:16.2px"&gt;Dictates a post-visit&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:16.2px"&gt;voice note on an iPhone&lt;/span&gt;' style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#08427B;strokeColor=#0E3A66;strokeWidth=1.5;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40.0" y="455.0" width="230.0" height="150.0" as="geometry"/></mxCell>
    <mxCell id="node-app" value='&lt;b style="font-size:20.2px"&gt;Mobile app&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:15.1px;color:#DCE9F7"&gt;[React Native / Expo · iOS only]&lt;/i&gt;&lt;br&gt;&lt;span style="font-size:16.2px"&gt;Records a WAV file,&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:16.2px"&gt;uploads it and displays&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:16.2px"&gt;the result&lt;/span&gt;' style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#1A6FC4;strokeColor=#0E3A66;strokeWidth=1.5;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="415.0" y="415.0" width="240.0" height="230.0" as="geometry"/></mxCell>
    <mxCell id="node-svc" value='&lt;b style="font-size:20.2px"&gt;Go service&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:15.1px;color:#DCE9F7"&gt;[Go / Gin · one process]&lt;/i&gt;&lt;br&gt;&lt;span style="font-size:16.2px"&gt;• Receives the upload&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:16.2px"&gt;• Validates the audio and the model output&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:16.2px"&gt;• Writes the result to Notion&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:16.2px"&gt;• Synchronous processing&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:16.2px"&gt;• No authentication&lt;/span&gt;' style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#1A6FC4;strokeColor=#0E3A66;strokeWidth=1.5;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="955.0" y="305.0" width="395.0" height="390.0" as="geometry"/></mxCell>
    <mxCell id="node-openai" value='&lt;i style="font-size:15.1px;color:#DCE9F7"&gt;[External system]&lt;/i&gt;&lt;br&gt;&lt;b style="font-size:20.2px"&gt;OpenAI&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:16.2px"&gt;gpt-audio-1.5 receives the&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:16.2px"&gt;audio and prompt in one API&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:16.2px"&gt;call and returns JSON&lt;/span&gt;' style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#6B6B6B;strokeColor=#0E3A66;strokeWidth=1.5;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1610.0" y="285.0" width="280.0" height="220.0" as="geometry"/></mxCell>
    <mxCell id="node-notion" value='&lt;i style="font-size:15.1px;color:#DCE9F7"&gt;[External system]&lt;/i&gt;&lt;br&gt;&lt;b style="font-size:20.2px"&gt;Notion&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:16.2px"&gt;Receives a child page under a&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:16.2px"&gt;private demo page&lt;/span&gt;' style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#6B6B6B;strokeColor=#0E3A66;strokeWidth=1.5;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1610.0" y="535.0" width="280.0" height="220.0" as="geometry"/></mxCell>
    <mxCell id="arrow-rep-app" value="Dictates a note,&lt;br&gt;uploads audio" style="endArrow=block;endFill=1;endSize=7;startArrow=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2.4;exitX=1.0000;exitY=0.3000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.3696;entryDx=0;entryDy=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=16.2;fontColor=#222222;fontStyle=1;align=center;verticalAlign=middle;" edge="1" parent="1" source="node-rep" target="node-app"><mxGeometry relative="1" as="geometry"><mxPoint x="-0.5" y="-30.4" as="offset"/></mxGeometry></mxCell>
    <mxCell id="arrow-app-rep" value="Shows the&lt;br&gt;result card" style="endArrow=block;endFill=1;endSize=7;startArrow=none;html=1;rounded=0;strokeColor=#0F766E;strokeWidth=2.4;exitX=0.0000;exitY=0.6522;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0000;entryY=0.7333;entryDx=0;entryDy=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=16.2;fontColor=#0B5D56;fontStyle=1;align=center;verticalAlign=middle;" edge="1" parent="1" source="node-app" target="node-rep"><mxGeometry relative="1" as="geometry"><mxPoint x="-0.5" y="30.4" as="offset"/></mxGeometry></mxCell>
    <mxCell id="arrow-app-svc" value='POST /notes (multipart audio)&lt;br&gt;&lt;span style="font-weight:normal"&gt;&lt;i&gt;[HTTP · 90 s timeout]&lt;/i&gt;&lt;/span&gt;' style="endArrow=block;endFill=1;endSize=7;startArrow=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2.4;exitX=1.0000;exitY=0.3696;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=16.2;fontColor=#222222;fontStyle=1;align=center;verticalAlign=middle;" edge="1" parent="1" source="node-app" target="node-svc"><mxGeometry relative="1" as="geometry"><mxPoint x="0.0" y="-30.4" as="offset"/></mxGeometry></mxCell>
    <mxCell id="arrow-svc-app" value="201 + JSON result:&lt;br&gt;summary, action items,&lt;br&gt;tags, Notion page URL" style="endArrow=block;endFill=1;endSize=7;startArrow=none;html=1;rounded=0;strokeColor=#0F766E;strokeWidth=2.4;exitX=0.0000;exitY=0.6667;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0000;entryY=0.6522;entryDx=0;entryDy=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=16.2;fontColor=#0B5D56;fontStyle=1;align=center;verticalAlign=middle;" edge="1" parent="1" source="node-svc" target="node-app"><mxGeometry relative="1" as="geometry"><mxPoint x="0.0" y="41.1" as="offset"/></mxGeometry></mxCell>
    <mxCell id="arrow-svc-openai" value='Audio + prompt&lt;br&gt;one synchronous call&lt;br&gt;&lt;span style="font-weight:normal"&gt;&lt;i&gt;[HTTPS · 60 s timeout]&lt;/i&gt;&lt;/span&gt;' style="endArrow=block;endFill=1;endSize=7;startArrow=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2.4;exitX=1.0000;exitY=0.1538;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.3636;entryDx=0;entryDy=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=16.2;fontColor=#222222;fontStyle=1;align=center;verticalAlign=middle;" edge="1" parent="1" source="node-svc" target="node-openai"><mxGeometry relative="1" as="geometry"><mxPoint x="32.0" y="-41.1" as="offset"/></mxGeometry></mxCell>
    <mxCell id="arrow-openai-svc" value="JSON result&lt;br&gt;returned as text" style="endArrow=block;endFill=1;endSize=7;startArrow=none;html=1;rounded=0;strokeColor=#0F766E;strokeWidth=2.4;exitX=0.0000;exitY=0.6591;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0000;entryY=0.3205;entryDx=0;entryDy=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=16.2;fontColor=#0B5D56;fontStyle=1;align=center;verticalAlign=middle;" edge="1" parent="1" source="node-openai" target="node-svc"><mxGeometry relative="1" as="geometry"><mxPoint x="32.0" y="30.4" as="offset"/></mxGeometry></mxCell>
    <mxCell id="arrow-svc-notion" value='Create child page&lt;br&gt;&lt;span style="font-weight:normal"&gt;&lt;i&gt;[HTTPS · 15 s timeout]&lt;/i&gt;&lt;/span&gt;' style="endArrow=block;endFill=1;endSize=7;startArrow=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2.4;exitX=1.0000;exitY=0.7949;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.3636;entryDx=0;entryDy=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=16.2;fontColor=#222222;fontStyle=1;align=center;verticalAlign=middle;" edge="1" parent="1" source="node-svc" target="node-notion"><mxGeometry relative="1" as="geometry"><mxPoint x="32.0" y="-30.4" as="offset"/></mxGeometry></mxCell>
    <mxCell id="arrow-notion-svc" value="Success or&lt;br&gt;error response" style="endArrow=block;endFill=1;endSize=7;startArrow=none;html=1;rounded=0;strokeColor=#0F766E;strokeWidth=2.4;exitX=0.0000;exitY=0.6591;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0000;entryY=0.9615;entryDx=0;entryDy=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=16.2;fontColor=#0B5D56;fontStyle=1;align=center;verticalAlign=middle;" edge="1" parent="1" source="node-notion" target="node-svc"><mxGeometry relative="1" as="geometry"><mxPoint x="32.0" y="30.4" as="offset"/></mxGeometry></mxCell>
    <mxCell id="note-scope" value="&lt;b&gt;Demo scope:&lt;/b&gt; no authentication, no database, no durable job queue, no asynchronous processing, and no CRM integration. Notion is the demo export target." style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;fillColor=#FFE9A8;strokeColor=#B07F00;strokeWidth=1.8;fontColor=#3B2F00;fontSize=17;" vertex="1" parent="1"><mxGeometry x="355.0" y="830.0" width="1060.0" height="105.0" as="geometry"/></mxCell>
    <mxCell id="note-oq" value="&lt;b&gt;Open question:&lt;/b&gt; The demo shows a rep dictating their own note after the visit, not recording the customer conversation. Confirm the production workflow: if the rep records the conversation, add the customer as a participant and a recording notice and consent step." style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;fillColor=#F3E8FF;strokeColor=#7C3AED;strokeWidth=1.8;fontColor=#2E1065;fontSize=16.2;" vertex="1" parent="1"><mxGeometry x="1440.0" y="790.0" width="440.0" height="185.0" as="geometry"/></mxCell>
    <mxCell id="note-src" value="&lt;b&gt;Source:&lt;/b&gt; backend/, mobile/ and docs/demo-flow.md; timeouts as coded." style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;fillColor=#FFF4CC;strokeColor=#C99A06;strokeWidth=1.8;fontColor=#3B2F00;fontSize=16.2;" vertex="1" parent="1"><mxGeometry x="40.0" y="960.0" width="300.0" height="70.0" as="geometry"/></mxCell>
