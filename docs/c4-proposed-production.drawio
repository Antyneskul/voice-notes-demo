<mxfile host="app.diagrams.net"><diagram id="proposed" name="Proposed production architecture — ADR 001"><mxGraphModel dx="1920" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
    <mxCell id="title" value='&lt;b style="font-size:34px"&gt;Proposed production architecture — ADR 001&lt;/b&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="48.0" y="30.0" width="1100.0" height="50.0" as="geometry"/></mxCell>
    <mxCell id="subtitle" value="C4 system context and container view · design proposal; none of these containers exist yet" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontColor=#555555;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="48.0" y="84.0" width="1100.0" height="28.0" as="geometry"/></mxCell>
    <mxCell id="badge" value="PROPOSED · not implemented" style="rounded=1;arcSize=50;html=1;fillColor=#B45309;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1629.2" y="40.0" width="242.8" height="38.0" as="geometry"/></mxCell>
    <mxCell id="zone-system" value='&lt;b&gt;Voice Line production system&lt;/b&gt; &lt;font color="#666666"&gt;[software system]&lt;/font&gt;' style="rounded=1;arcSize=2;html=1;fillColor=none;strokeColor=#333333;strokeWidth=2.5;dashed=1;dashPattern=10 6;fontColor=#111111;fontSize=15.0;align=right;verticalAlign=top;spacingRight=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="235.0" y="285.0" width="1340.0" height="595.0" as="geometry"/></mxCell>
    <mxCell id="zone-device" value="&lt;b&gt;Rep's device&lt;/b&gt;" style="rounded=1;arcSize=2;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=2;dashed=1;dashPattern=7 5;fontColor=#475569;fontSize=15.0;align=left;verticalAlign=bottom;spacingLeft=14;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="255.0" y="335.0" width="250.0" height="290.0" as="geometry"/></mxCell>
    <mxCell id="zone-aws" value="&lt;b&gt;AWS — hosting and trust boundary&lt;/b&gt;" style="rounded=1;arcSize=2;html=1;fillColor=#FFF6E5;strokeColor=#D97706;strokeWidth=2;dashed=1;dashPattern=7 5;fontColor=#92400E;fontSize=15.0;align=left;verticalAlign=bottom;spacingLeft=14;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="600.0" y="335.0" width="950.0" height="527.0" as="geometry"/></mxCell>
    <mxCell id="node-rep" value='&lt;i style="font-size:13.5px;color:#DCE9F7"&gt;[Person]&lt;/i&gt;&lt;br&gt;&lt;b style="font-size:18.0px"&gt;Sales rep&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:14.5px"&gt;Dictates a voice&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:14.5px"&gt;note after a&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:14.5px"&gt;customer visit,&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:14.5px"&gt;including offline,&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:14.5px"&gt;then reviews and&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:14.5px"&gt;approves the draft&lt;/span&gt;' style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#08427B;strokeColor=#0E3A66;strokeWidth=1.5;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="12.0" y="375.0" width="168.0" height="210.0" as="geometry"/></mxCell>
    <mxCell id="node-admin" value='&lt;i style="font-size:13.5px;color:#DCE9F7"&gt;[Person]&lt;/i&gt;&lt;br&gt;&lt;b style="font-size:18.0px"&gt;Tenant admin /&lt;/b&gt;&lt;br&gt;&lt;b style="font-size:18.0px"&gt;support&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:14.5px"&gt;Sets up tenant users and CRM&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:14.5px"&gt;connections, helps recover&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:14.5px"&gt;failed exports&lt;/span&gt;' style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#08427B;strokeColor=#0E3A66;strokeWidth=1.5;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="820.0" y="125.0" width="250.0" height="135.0" as="geometry"/></mxCell>
    <mxCell id="node-idp" value='&lt;i style="font-size:13.5px;color:#DCE9F7"&gt;[External system]&lt;/i&gt;&lt;br&gt;&lt;b style="font-size:18.0px"&gt;Identity provider&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:14.5px"&gt;OIDC login, short-lived tokens and&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:14.5px"&gt;JWKS public keys&lt;/span&gt;' style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#6B6B6B;strokeColor=#0E3A66;strokeWidth=1.5;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300.0" y="125.0" width="290.0" height="135.0" as="geometry"/></mxCell>
    <mxCell id="node-app" value='&lt;b style="font-size:18.0px"&gt;Mobile app&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:13.5px;color:#DCE9F7"&gt;[React Native / Expo · SQLite]&lt;/i&gt;&lt;br&gt;&lt;span style="font-size:14.5px"&gt;Offline capture, upload&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:14.5px"&gt;state, review and&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:14.5px"&gt;approval&lt;/span&gt;' style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#1A6FC4;strokeColor=#0E3A66;strokeWidth=1.5;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="280.0" y="385.0" width="200.0" height="190.0" as="geometry"/></mxCell>
    <mxCell id="node-api" value='&lt;b style="font-size:18.0px"&gt;API&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:13.5px;color:#DCE9F7"&gt;[Go / Gin · AWS ECS Fargate]&lt;/i&gt;&lt;br&gt;&lt;span style="font-size:14.5px"&gt;• Notes and tenant-scoped&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:14.5px"&gt;authorization&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:14.5px"&gt;• Presigned uploads&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:14.5px"&gt;• Review and approval&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:14.5px"&gt;• Validates JWT using IdP&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:14.5px"&gt;JWKS, locally&lt;/span&gt;' style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#1A6FC4;strokeColor=#0E3A66;strokeWidth=1.5;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="650.0" y="345.0" width="250.0" height="300.0" as="geometry"/></mxCell>
    <mxCell id="node-db" value='&lt;b style="font-size:18.0px"&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:13.5px;color:#DCE9F7"&gt;[AWS RDS]&lt;/i&gt;&lt;br&gt;&lt;span style="font-size:14.5px"&gt;Note state,&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:14.5px"&gt;transcripts, drafts,&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:14.5px"&gt;extraction and export&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:14.5px"&gt;jobs&lt;/span&gt;' style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;html=1;whiteSpace=wrap;fillColor=#1A6FC4;strokeColor=#0E4C8A;strokeWidth=1.5;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1037.0" y="345.0" width="190.0" height="150.0" as="geometry"/></mxCell>
    <mxCell id="node-secrets" value='&lt;b style="font-size:18.0px"&gt;AWS Secrets&lt;/b&gt;&lt;br&gt;&lt;b style="font-size:18.0px"&gt;Manager&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:14.5px"&gt;Provider keys and&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:14.5px"&gt;tenant CRM&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:14.5px"&gt;credentials&lt;/span&gt;' style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#1A6FC4;strokeColor=#0E3A66;strokeWidth=1.5;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1037.0" y="545.0" width="190.0" height="140.0" as="geometry"/></mxCell>
    <mxCell id="node-s3" value='&lt;b style="font-size:18.0px"&gt;Audio store&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:13.5px;color:#DCE9F7"&gt;[AWS S3]&lt;/i&gt;&lt;br&gt;&lt;span style="font-size:14.5px"&gt;Uploaded audio&lt;/span&gt;' style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;html=1;whiteSpace=wrap;fillColor=#1A6FC4;strokeColor=#0E4C8A;strokeWidth=1.5;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1037.0" y="725.0" width="190.0" height="120.0" as="geometry"/></mxCell>
    <mxCell id="node-worker" value='&lt;b style="font-size:18.0px"&gt;Worker&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:13.5px;color:#DCE9F7"&gt;[Go · AWS ECS Fargate]&lt;/i&gt;&lt;br&gt;&lt;span style="font-size:14.5px"&gt;• Claims jobs with a&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:14.5px"&gt;lease&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:14.5px"&gt;• Runs AI&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:14.5px"&gt;processing: speech-&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:14.5px"&gt;to-text, then LLM&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:14.5px"&gt;• Exports approved&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:14.5px"&gt;notes to the CRM&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:14.5px"&gt;• Bounded retries&lt;/span&gt;' style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#1A6FC4;strokeColor=#0E3A66;strokeWidth=1.5;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1345.0" y="345.0" width="180.0" height="500.0" as="geometry"/></mxCell>
    <mxCell id="node-stt" value='&lt;i style="font-size:13.5px;color:#DCE9F7"&gt;[External system]&lt;/i&gt;&lt;br&gt;&lt;b style="font-size:18.0px"&gt;Speech-to-text&lt;/b&gt;&lt;br&gt;&lt;b style="font-size:18.0px"&gt;provider&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:14.5px"&gt;Receives audio,&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:14.5px"&gt;returns a transcript&lt;/span&gt;' style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#6B6B6B;strokeColor=#0E3A66;strokeWidth=1.5;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1710.0" y="330.0" width="190.0" height="150.0" as="geometry"/></mxCell>
    <mxCell id="node-llm" value='&lt;i style="font-size:13.5px;color:#DCE9F7"&gt;[External system]&lt;/i&gt;&lt;br&gt;&lt;b style="font-size:18.0px"&gt;LLM provider&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:14.5px"&gt;Receives the&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:14.5px"&gt;transcript, returns a&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:14.5px"&gt;structured draft&lt;/span&gt;' style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#6B6B6B;strokeColor=#0E3A66;strokeWidth=1.5;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1710.0" y="515.0" width="190.0" height="150.0" as="geometry"/></mxCell>
    <mxCell id="node-crm" value='&lt;i style="font-size:13.5px;color:#DCE9F7"&gt;[External system]&lt;/i&gt;&lt;br&gt;&lt;b style="font-size:18.0px"&gt;Tenant CRM&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:14.5px"&gt;Receives the rep-&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:14.5px"&gt;approved note&lt;/span&gt;' style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#6B6B6B;strokeColor=#0E3A66;strokeWidth=1.5;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1710.0" y="710.0" width="190.0" height="150.0" as="geometry"/></mxCell>
    <mxCell id="arrow-rep-app" value="Dictates,&lt;br&gt;reviews,&lt;br&gt;edits,&lt;br&gt;approves" style="endArrow=block;endFill=1;endSize=7;startArrow=block;startFill=1;startSize=7;html=1;rounded=0;strokeColor=#333333;strokeWidth=2.4;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=14.5;fontColor=#222222;fontStyle=1;align=center;verticalAlign=middle;" edge="1" parent="1" source="node-rep" target="node-app"><mxGeometry relative="1" as="geometry"><mxPoint x="0.0" y="-52.0" as="offset"/></mxGeometry></mxCell>
    <mxCell id="arrow-app-idp" value="OIDC&lt;br&gt;sign-in" style="endArrow=block;endFill=1;endSize=7;startArrow=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2.4;exitX=0.3000;exitY=0.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.1379;entryY=1.0000;entryDx=0;entryDy=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=14.5;fontColor=#222222;fontStyle=1;align=center;verticalAlign=middle;" edge="1" parent="1" source="node-app" target="node-idp"><mxGeometry relative="1" as="geometry"><mxPoint x="-40.4" y="-0.5" as="offset"/></mxGeometry></mxCell>
    <mxCell id="arrow-idp-app" value="Short-lived&lt;br&gt;token (JWT)" style="endArrow=block;endFill=1;endSize=7;startArrow=none;html=1;rounded=0;strokeColor=#0F766E;strokeWidth=2.4;exitX=0.3448;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.6000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=14.5;fontColor=#0B5D56;fontStyle=1;align=center;verticalAlign=middle;" edge="1" parent="1" source="node-idp" target="node-app"><mxGeometry relative="1" as="geometry"><mxPoint x="55.5" y="-0.5" as="offset"/></mxGeometry></mxCell>
    <mxCell id="arrow-api-idp" value="Fetch JWKS&lt;br&gt;public keys (cached)" style="endArrow=block;endFill=1;endSize=7;startArrow=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2.4;exitX=0.4400;exitY=0.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0000;entryY=0.3704;entryDx=0;entryDy=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=14.5;fontColor=#222222;fontStyle=1;align=center;verticalAlign=middle;" edge="1" parent="1" source="node-api" target="node-idp"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="760.0" y="175.0"/></Array><mxPoint x="-85.0" y="-28.1" as="offset"/></mxGeometry></mxCell>
    <mxCell id="arrow-idp-api" value="Public keys&lt;br&gt;(JWKS)" style="endArrow=block;endFill=1;endSize=7;startArrow=none;html=1;rounded=0;strokeColor=#0F766E;strokeWidth=2.4;exitX=1.0000;exitY=0.7407;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.2400;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=14.5;fontColor=#0B5D56;fontStyle=1;align=center;verticalAlign=middle;" edge="1" parent="1" source="node-idp" target="node-api"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="710.0" y="225.0"/></Array><mxPoint x="-60.0" y="28.1" as="offset"/></mxGeometry></mxCell>
    <mxCell id="arrow-admin-api" value="Tenant setup, CRM connection,&lt;br&gt;export recovery and monitoring" style="endArrow=block;endFill=1;endSize=7;startArrow=block;startFill=1;startSize=7;html=1;rounded=0;strokeColor=#333333;strokeWidth=2.4;exitX=0.2000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.8800;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=14.5;fontColor=#222222;fontStyle=1;align=center;verticalAlign=middle;" edge="1" parent="1" source="node-admin" target="node-api"><mxGeometry relative="1" as="geometry"><mxPoint x="127.1" y="1.5" as="offset"/></mxGeometry></mxCell>
    <mxCell id="arrow-app-api" value='Create note, poll,&lt;br&gt;review, approve&lt;br&gt;&lt;span style="font-weight:normal"&gt;&lt;i&gt;[HTTPS / JSON]&lt;/i&gt;&lt;/span&gt;' style="endArrow=block;endFill=1;endSize=7;startArrow=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2.4;exitX=1.0000;exitY=0.3158;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.3333;entryDx=0;entryDy=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=14.5;fontColor=#222222;fontStyle=1;align=center;verticalAlign=middle;" edge="1" parent="1" source="node-app" target="node-api"><mxGeometry relative="1" as="geometry"><mxPoint x="0.0" y="-37.7" as="offset"/></mxGeometry></mxCell>
    <mxCell id="arrow-api-app" value="Status, draft,&lt;br&gt;presigned URL" style="endArrow=block;endFill=1;endSize=7;startArrow=none;html=1;rounded=0;strokeColor=#0F766E;strokeWidth=2.4;exitX=0.0000;exitY=0.5667;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0000;entryY=0.6842;entryDx=0;entryDy=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=14.5;fontColor=#0B5D56;fontStyle=1;align=center;verticalAlign=middle;" edge="1" parent="1" source="node-api" target="node-app"><mxGeometry relative="1" as="geometry"><mxPoint x="0.0" y="28.1" as="offset"/></mxGeometry></mxCell>
    <mxCell id="arrow-app-s3" value="Upload audio via a short-lived,&lt;br&gt;scoped presigned URL [HTTPS]" style="endArrow=block;endFill=1;endSize=7;startArrow=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2.4;exitX=0.7000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.8083;entryDx=0;entryDy=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=14.5;fontColor=#222222;fontStyle=1;align=center;verticalAlign=middle;" edge="1" parent="1" source="node-app" target="node-s3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="420.0" y="822.0"/></Array><mxPoint x="-48.1" y="-30.1" as="offset"/></mxGeometry></mxCell>
    <mxCell id="arrow-api-s3" value="Verify uploaded object" style="endArrow=block;endFill=1;endSize=7;startArrow=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2.4;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.3917;entryDx=0;entryDy=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=14.5;fontColor=#222222;fontStyle=1;align=center;verticalAlign=middle;" edge="1" parent="1" source="node-api" target="node-s3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="775.0" y="772.0"/></Array><mxPoint x="30.4" y="-18.6" as="offset"/></mxGeometry></mxCell>
    <mxCell id="arrow-api-db" value="Note state +&lt;br&gt;job, one&lt;br&gt;SQL txn" style="endArrow=block;endFill=1;endSize=7;startArrow=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2.4;exitX=1.0000;exitY=0.2500;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=14.5;fontColor=#222222;fontStyle=1;align=center;verticalAlign=middle;" edge="1" parent="1" source="node-api" target="node-db"><mxGeometry relative="1" as="geometry"><mxPoint x="-0.5" y="-37.7" as="offset"/></mxGeometry></mxCell>
    <mxCell id="arrow-worker-db" value="Claim jobs&lt;br&gt;(lease), save&lt;br&gt;stage results" style="endArrow=block;endFill=1;endSize=7;startArrow=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2.4;exitX=0.0000;exitY=0.1500;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=14.5;fontColor=#222222;fontStyle=1;align=center;verticalAlign=middle;" edge="1" parent="1" source="node-worker" target="node-db"><mxGeometry relative="1" as="geometry"><mxPoint x="0.0" y="-37.7" as="offset"/></mxGeometry></mxCell>
    <mxCell id="arrow-worker-secrets" value="Read provider&lt;br&gt;key or CRM&lt;br&gt;credential" style="endArrow=block;endFill=1;endSize=7;startArrow=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2.4;exitX=0.0000;exitY=0.5400;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=14.5;fontColor=#222222;fontStyle=1;align=center;verticalAlign=middle;" edge="1" parent="1" source="node-worker" target="node-secrets"><mxGeometry relative="1" as="geometry"><mxPoint x="0.0" y="-37.7" as="offset"/></mxGeometry></mxCell>
    <mxCell id="arrow-worker-s3" value="Read authorized&lt;br&gt;audio object" style="endArrow=block;endFill=1;endSize=7;startArrow=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2.4;exitX=0.0000;exitY=0.8900;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0000;entryY=0.5417;entryDx=0;entryDy=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=14.5;fontColor=#222222;fontStyle=1;align=center;verticalAlign=middle;" edge="1" parent="1" source="node-worker" target="node-s3"><mxGeometry relative="1" as="geometry"><mxPoint x="0.0" y="-28.1" as="offset"/></mxGeometry></mxCell>
    <mxCell id="arrow-worker-stt" value='Sends audio&lt;br&gt;&lt;span style="font-weight:normal"&gt;&lt;i&gt;[HTTPS]&lt;/i&gt;&lt;/span&gt;' style="endArrow=block;endFill=1;endSize=7;startArrow=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2.4;exitX=1.0000;exitY=0.0700;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.3333;entryDx=0;entryDy=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=14.5;fontColor=#222222;fontStyle=1;align=center;verticalAlign=middle;" edge="1" parent="1" source="node-worker" target="node-stt"><mxGeometry relative="1" as="geometry"><mxPoint x="-0.5" y="-28.1" as="offset"/></mxGeometry></mxCell>
    <mxCell id="arrow-stt-worker" value="Returns&lt;br&gt;transcript" style="endArrow=block;endFill=1;endSize=7;startArrow=none;html=1;rounded=0;strokeColor=#0F766E;strokeWidth=2.4;exitX=0.0000;exitY=0.6667;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0000;entryY=0.1700;entryDx=0;entryDy=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=14.5;fontColor=#0B5D56;fontStyle=1;align=center;verticalAlign=middle;" edge="1" parent="1" source="node-stt" target="node-worker"><mxGeometry relative="1" as="geometry"><mxPoint x="-0.5" y="28.1" as="offset"/></mxGeometry></mxCell>
    <mxCell id="arrow-worker-llm" value='Sends transcript&lt;br&gt;&lt;span style="font-weight:normal"&gt;&lt;i&gt;[HTTPS]&lt;/i&gt;&lt;/span&gt;' style="endArrow=block;endFill=1;endSize=7;startArrow=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2.4;exitX=1.0000;exitY=0.4400;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.3333;entryDx=0;entryDy=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=14.5;fontColor=#222222;fontStyle=1;align=center;verticalAlign=middle;" edge="1" parent="1" source="node-worker" target="node-llm"><mxGeometry relative="1" as="geometry"><mxPoint x="-0.5" y="-28.1" as="offset"/></mxGeometry></mxCell>
    <mxCell id="arrow-llm-worker" value="Returns structured&lt;br&gt;draft (JSON)" style="endArrow=block;endFill=1;endSize=7;startArrow=none;html=1;rounded=0;strokeColor=#0F766E;strokeWidth=2.4;exitX=0.0000;exitY=0.6667;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0000;entryY=0.5400;entryDx=0;entryDy=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=14.5;fontColor=#0B5D56;fontStyle=1;align=center;verticalAlign=middle;" edge="1" parent="1" source="node-llm" target="node-worker"><mxGeometry relative="1" as="geometry"><mxPoint x="-0.5" y="28.1" as="offset"/></mxGeometry></mxCell>
    <mxCell id="arrow-worker-crm" value='Sends approved version&lt;br&gt;+ idempotency key&lt;br&gt;&lt;span style="font-weight:normal"&gt;&lt;i&gt;[HTTPS]&lt;/i&gt;&lt;/span&gt;' style="endArrow=block;endFill=1;endSize=7;startArrow=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2.4;exitX=1.0000;exitY=0.8700;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.4667;entryDx=0;entryDy=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=14.5;fontColor=#222222;fontStyle=1;align=center;verticalAlign=middle;" edge="1" parent="1" source="node-worker" target="node-crm"><mxGeometry relative="1" as="geometry"><mxPoint x="-0.5" y="-37.7" as="offset"/></mxGeometry></mxCell>
    <mxCell id="arrow-crm-worker" value="Returns success&lt;br&gt;or error" style="endArrow=block;endFill=1;endSize=7;startArrow=none;html=1;rounded=0;strokeColor=#0F766E;strokeWidth=2.4;exitX=0.0000;exitY=0.8000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0000;entryY=0.9700;entryDx=0;entryDy=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=14.5;fontColor=#0B5D56;fontStyle=1;align=center;verticalAlign=middle;" edge="1" parent="1" source="node-crm" target="node-worker"><mxGeometry relative="1" as="geometry"><mxPoint x="-0.5" y="28.1" as="offset"/></mxGeometry></mxCell>
    <mxCell id="note-n1" value="Database-backed job queue; no separate queue service is assumed in this proposal." style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;fillColor=#FFF4CC;strokeColor=#C99A06;strokeWidth=1.8;fontColor=#3B2F00;fontSize=14.5;" vertex="1" parent="1"><mxGeometry x="40.0" y="895.0" width="925.0" height="30.0" as="geometry"/></mxCell>
    <mxCell id="note-n2" value="Retries are bounded; failed jobs remain recoverable. CRM export is idempotent." style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;fillColor=#FFF4CC;strokeColor=#C99A06;strokeWidth=1.8;fontColor=#3B2F00;fontSize=14.5;" vertex="1" parent="1"><mxGeometry x="40.0" y="929.0" width="925.0" height="30.0" as="geometry"/></mxCell>
    <mxCell id="note-n3" value="Human review and approval happen before CRM export." style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;fillColor=#FFF4CC;strokeColor=#C99A06;strokeWidth=1.8;fontColor=#3B2F00;fontSize=14.5;" vertex="1" parent="1"><mxGeometry x="40.0" y="963.0" width="925.0" height="30.0" as="geometry"/></mxCell>
    <mxCell id="note-n4" value="Retention and deletion policy covers audio, transcripts, drafts, logs where applicable, and backups." style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;fillColor=#FFF4CC;strokeColor=#C99A06;strokeWidth=1.8;fontColor=#3B2F00;fontSize=14.5;" vertex="1" parent="1"><mxGeometry x="40.0" y="997.0" width="925.0" height="30.0" as="geometry"/></mxCell>
    <mxCell id="note-n5" value="Offline audio is stored on the device until upload succeeds, then deleted in line with the retention policy." style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;fillColor=#FFF4CC;strokeColor=#C99A06;strokeWidth=1.8;fontColor=#3B2F00;fontSize=14.5;" vertex="1" parent="1"><mxGeometry x="40.0" y="1031.0" width="925.0" height="30.0" as="geometry"/></mxCell>
    <mxCell id="note-n6" value="&lt;b&gt;Design change:&lt;/b&gt; The production proposal uses separate transcription and extraction stages. The demo uses one multimodal audio call. This is an intentional design change whose latency, cost, and quality trade-offs should be evaluated." style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;fillColor=#FFF4CC;strokeColor=#C99A06;strokeWidth=1.8;fontColor=#3B2F00;fontSize=14.5;" vertex="1" parent="1"><mxGeometry x="985.0" y="895.0" width="895.0" height="76.0" as="geometry"/></mxCell>
    <mxCell id="note-oq" value="&lt;b&gt;Open question:&lt;/b&gt; These diagrams assume the rep dictates their own voice note after the visit, as the demo does. Confirm with product: if the rep instead records the customer conversation, add the customer as a participant and a recording notice and consent step." style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;fillColor=#F3E8FF;strokeColor=#7C3AED;strokeWidth=1.8;fontColor=#2E1065;fontSize=14.5;" vertex="1" parent="1"><mxGeometry x="985.0" y="975.0" width="895.0" height="86.0" as="geometry"/></mxCell>
