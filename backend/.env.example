# Copy to .env and fill in. The server refuses to start if a required value is missing.

# Required
OPENAI_API_KEY=sk-your-openai-key
NOTION_API_KEY=your-notion-personal-access-token
# The page the notes are created under (the 32-character ID at the end of its URL).
NOTION_PARENT_PAGE_ID=your-parent-page-id

# Optional (defaults shown)
# PORT=8080
# OPENAI_MODEL=gpt-audio-1.5
# Base URLs: no trailing /v1 (the service adds /v1/chat/completions and /v1/pages itself).
# OPENAI_BASE_URL=https://api.openai.com
# NOTION_BASE_URL=https://api.notion.com
