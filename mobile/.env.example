# Optional. By default the app finds the backend by itself: it takes the address of the
# computer running Expo and uses port 8080 on it, so there is nothing to set.
# Uncomment to override, for example when the backend runs on another machine or port.
# Expo inlines EXPO_PUBLIC_* values into the app at start-up, so never put secrets here.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8080
